# === OANDA v20 API 認証情報 ===
# デモ口座を開設して発行したものを設定する:
#   https://www.oanda.com/  ->  デモ口座開設 -> 「APIアクセスの管理」からトークン発行
#
# このファイルをコピーして `.env` を作り、値を埋める:
#   cp .env.example .env
# ⚠ .env は絶対にコミットしないこと（.gitignore で除外済み）

# 環境: practice(デモ) または live(本番)。当面は practice 固定。
OANDA_ENV=practice

# APIトークン
OANDA_API_TOKEN=your_api_token_here

# アカウントID（例: 101-009-1234567-001）
OANDA_ACCOUNT_ID=your_account_id_here

# === 取引デフォルト設定 ===
# 対象通貨ペア（OANDA表記はアンダースコア区切り）
DEFAULT_INSTRUMENT=USD_JPY

# ローソク足の粒度（M1,M5,M15,H1,H4,D など）
DEFAULT_GRANULARITY=H1

# === リスク管理 ===
# 1トレードで許容する口座資金の割合（%）
RISK_PER_TRADE_PCT=1.0

# 損切り幅（pips）
STOP_LOSS_PIPS=20

# 利確幅（pips）
TAKE_PROFIT_PIPS=40

# 1日の最大損失（%）— これを超えたら自動停止
MAX_DAILY_LOSS_PCT=5.0
